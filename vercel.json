{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 9 */4 * *"
    },
    {
      "path": "/api/send-scheduled",
      "schedule": "0 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/landing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/preview",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://getbizidea.com/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.getbizidea.com"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "https://getbizidea.com/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "getbizidea.io"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "https://getbizidea.com/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.getbizidea.io"
        }
      ]
    }
  ]
}
